# The app's only pods, and both exist for one reason: iOS can read WebP but has no system encoder
# for it, so "Convert to WebP" needs one supplied.
#
# The Kotlin side binds these in composeApp/build.gradle.kts, which gives the compiler headers but
# no object code — ComposeApp.framework is static and leaves the SDWebImage symbols undefined, so
# the app target has to link the real pods. Keep the versions in step with that cocoapods block.
#
# Declaring those pods is also what pulled the Kotlin framework itself into CocoaPods: the Kotlin
# Gradle plugin refuses to combine pod dependencies with the old `embedAndSign` script phase, so
# `composeApp` is a pod here too and its podspec builds the framework.
#
# After changing this file run `pod install` and open iosApp.xcworkspace, not iosApp.xcodeproj.
platform :ios, '15.0'

target 'iosApp' do
  use_frameworks!

  # The Kotlin framework: AVIF Studio's entire UI. Its podspec is generated by
  # `./gradlew :composeApp:podspec` and its script phase builds the framework during the Xcode
  # build, replacing the old manual embedAndSign phase.
  pod 'composeApp', :path => '../composeApp'

  pod 'SDWebImage', '~> 5.0'
  pod 'SDWebImageWebPCoder', '~> 0.14'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Match the app; the pods' own defaults are older and Xcode warns on every build otherwise.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
