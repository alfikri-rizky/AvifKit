# Kotlin/Native cinterop binding for libavif's C API.
#
# This lets AvifConverter.ios.kt call libavif directly (avifEncoderCreate/Write,
# avifImageRGBToYUV, avifDecoderReadMemory, ...) — the iOS analog of the Android
# JNI path in shared-native/src/main/cpp/avif_jni_wrapper.cpp.
#
# Headers come from the same libavif v1.2.1 source vendored for Android. The
# header search dir (includeDirs) and the per-target static-lib link flags
# (-L<dir> -lavif -laom) are supplied from shared/build.gradle.kts so they can
# vary per iOS target (device vs. simulator vs. x64); they are intentionally NOT
# hard-coded here.
headers = avif/avif.h
headerFilter = avif/**
package = libavif
