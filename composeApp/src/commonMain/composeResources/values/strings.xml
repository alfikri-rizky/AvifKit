<?xml version="1.0" encoding="utf-8"?>
<!--
  Default (English) copy for AVIF Studio.

  Indonesian lives in values-id/. A Gradle task mirrors values-id into values-in before the
  resources are converted, because Android reports Indonesian with the legacy ISO code "in" and
  Compose Resources matches the qualifier against exactly what the platform reports.
-->
<resources>
    <string name="app_name">AVIF Studio</string>
    <string name="tagline">Shrink and convert images, right on your device</string>

    <!-- Empty state -->
    <string name="empty_title">Nothing to convert yet</string>
    <string name="empty_body">Add photos or files, then pick what you need them for.</string>
    <string name="privacy_note">Everything happens on this device. No uploads, no account, no ads.</string>

    <!-- Actions -->
    <string name="add_photos">Add photos</string>
    <string name="add_files">Add files</string>
