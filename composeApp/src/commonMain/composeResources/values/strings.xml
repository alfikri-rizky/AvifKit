    <!-- About -->
    <string name="about_body">AVIF is a modern image format that usually stores the same photo in about half the space of a JPEG. This app converts to it, and back out of it when whatever you are sending to cannot read it yet.</string>
    <string name="about_offline">Works fully offline. Free, with no ads and nothing to buy.</string>
